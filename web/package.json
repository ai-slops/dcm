{
  "name": "pump-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "corepack pnpm run build:client && corepack pnpm run build:server",
    "build:client": "vite build",
    "build:server": "node esbuild.config.ts",
    "dev": "vite",
    "dev:server": "node --experimental-transform-types --watch --env-file-if-exists=.env server/index.ts",
    "fixture:provider": "node tests/support/fixture-provider.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:browser:ucs": "node tests/browser/ucs-roundtrip.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@slop-lab/part": "0.1.0",
    "@slop-lab/part-plugins": "0.1.0",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "ky": "2.2.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "react-doctor": "0.9.18",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
