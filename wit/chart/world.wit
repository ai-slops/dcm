package pump:chart@0.2.0;

interface plan-builder {
  record weighted-node {
    weight: u32,
    node: u32,
  }

  resource builder {
    constructor();
    tap: func(panel-mask: u16, semantic-key: string, provenance: string) -> result<u32, string>;
    hold: func(panel-mask: u16, duration-ticks: u64, semantic-key: string, provenance: string) -> result<u32, string>;
    rest: func(duration-ticks: u64, semantic-key: string, provenance: string) -> result<u32, string>;
    sequence: func(children: list<u32>, semantic-key: string, provenance: string) -> result<u32, string>;
    parallel: func(children: list<u32>, semantic-key: string, provenance: string) -> result<u32, string>;
    repeat: func(child: u32, times: u32, semantic-key: string, provenance: string) -> result<u32, string>;
    choice: func(alternatives: list<weighted-node>, semantic-key: string, provenance: string) -> result<u32, string>;
    mirror: func(child: u32, semantic-key: string, provenance: string) -> result<u32, string>;
    finish: func(root: u32) -> result<_, string>;
  }
}

interface author {
  build: func() -> result<_, string>;
}

interface runtime {
  generate: func(program-bytes: list<u8>, request-bytes: list<u8>) -> result<list<u8>, string>;
}

world author-world {
  import plan-builder;
  export author;
}

world runtime-world {
  export runtime;
}
