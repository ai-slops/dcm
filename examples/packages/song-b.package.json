      "exports": ["render"],
      "contract": "pump.pattern/v1",
      "capabilities": ["pump.mirror", "pump.sequence", "pump.tap"]
    },
    {
      "key": "style",
      "name": "bold-style",
      "version": "1.0.0",
      "role": "style",
      "component": "style-bold.component.wasm",
      "exports": ["policy"],
      "contract": "pump.style/v1"
    }
  ]
}
